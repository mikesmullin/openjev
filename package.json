{
  "name": "verdict-mars",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "openJev-verdict-2.0 (149.6M ModernBERT) making typed decisions in vibe-arcade's MARS RAID",
  "scripts": {
    "game": "bash scripts/fetch-game.sh",
    "model:prepare": "bash scripts/download-verdict.sh --slim",
    "model": "./.venv/bin/python server/verdict_server.py --port 8750",
    "model:cpu": "./.venv/bin/python server/verdict_server.py --port 8750 --device cpu",
    "model:selftest": "./.venv/bin/python server/verdict_server.py --selftest",
    "dev": "bun server/static.js",
    "start": "bun server/static.js"
  }
}
